if [[ -z $P10K_INSTANT_PROMPT_LOADED ]]; then
  # setup dir env with direnv
  # emulate zsh -c "$(direnv export zsh)"
  # prompt user while shell loading
    # define cache path
  CACHE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
  [[ -r "$CACHE_FILE" ]] && source "$CACHE_FILE"
  # enable direnv hook (e.g., when changing dir)
  # emulate zsh -c "$(direnv hook zsh)"
fi

{{ if eq .chezmoi.os "darwin" -}}
export PATH="/opt/homebrew/opt/ruby@3.2/bin:$PATH"
{{ end -}}
# Add Nix and user binaries; later entries take precedence.
export PATH="$HOME/.nix-profile/bin:$PATH"
export PATH="/nix/var/nix/profiles/default/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

export DIRENV_LOG_FORMAT="$(printf "\033[2mdirenv: %%s\033[0m")"
eval "$(direnv hook zsh)"
_direnv_hook() {
  eval "$(direnv export zsh 2> >(grep -Ev '^....direnv: export' >&2))"
}

# configure custom themes directory
export ZSH_CUSTOM="$HOME/.oh-my-zsh-custom"
mkdir -p "$ZSH_CUSTOM/themes"
# Use the Nix-provided prompt and shell framework when the store is mounted.
P10K_THEME_PATHS=(/nix/store/*powerlevel10k*/share/zsh-powerlevel10k/powerlevel10k.zsh-theme(N))
P10K_THEME_PATH="${P10K_THEME_PATHS[1]:-}"
if [[ -n "$P10K_THEME_PATH" ]]; then
  ln -sf "$P10K_THEME_PATH" "$ZSH_CUSTOM/themes/powerlevel10k.zsh-theme"
fi
# disable wizard launch on each login
export POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
# set ZSH path
NIX_OMZ_PATHS=(/nix/store/*oh-my-zsh*/share/oh-my-zsh(N/))
NIX_OMZ_PATH="${NIX_OMZ_PATHS[1]:-}"
if [[ -f "$NIX_OMZ_PATH/oh-my-zsh.sh" ]]; then
  export ZSH="$NIX_OMZ_PATH"
  ZSH_THEME="powerlevel10k"
  source "$NIX_OMZ_PATH/oh-my-zsh.sh"
  [[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
fi
unset P10K_THEME_PATHS NIX_OMZ_PATHS

# enable colorized output for terminal commands (e.g., ls)
if ls --color=auto -d . >/dev/null 2>&1; then
  alias ls='ls --color=auto'
else
  alias ls='ls -G'
fi
# set Emacs bindings for command line
bindkey -e

# aliases
alias cm='chezmoi'
alias nv='nvim'
alias tm='tmux'
alias g='git'
alias t='tree -L 3'
# Load completion for git
autoload -Uz compinit && compinit
# Make git completion work with g alias
compdef _git g=git
alias python='python3'
alias pn='pnpm'
alias lg='lazygit'
# command combining cd and ls
cl() { cd "$@" && ls; }
